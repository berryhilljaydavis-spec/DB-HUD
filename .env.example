# DB HUD configuration. Copy to .env — every value is optional.
# Any source without credentials renders realistic demo data instead (badge shows DEMO).

# --- Slack ---
# Bot token (xoxb-…) or user token (xoxp-…).
# Scopes: channels:history, channels:read, groups:history, groups:read, users:read
# The bot must be invited to each channel you want on the HUD.
SLACK_TOKEN=
# Optional: restrict to specific channels (names or IDs, comma separated).
SLACK_CHANNELS=#eng-platform,#standup
# Optional: your Slack member ID (U…) so "@you" messages count as mentions.
SLACK_USER_ID=

# --- Google (Gmail + Calendar) ---
# Create an OAuth client (Desktop app) at https://console.cloud.google.com/apis/credentials,
# enable the Gmail API and Google Calendar API, then obtain a refresh token with scopes:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/calendar.readonly
# The quickest way is https://developers.google.com/oauthplayground (use your own client id/secret).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: a specific calendar id, defaults to your primary calendar.
GOOGLE_CALENDAR_ID=primary

# --- Spotify (Podcast panel: newest TBPN episode) ---
# Create an app at https://developer.spotify.com/dashboard — no redirect URI or user
# login is needed, the panel only uses the client-credentials flow to read public shows.
# Without these the panel still deep-links to the TBPN show page.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: another show to track, defaults to TBPN.
SPOTIFY_SHOW_ID=2L6WMqY3GUPCGBD0dX6p00
# Optional: market used when listing episodes.
SPOTIFY_MARKET=US
# Optional: only queue episodes whose title contains this (empty = every episode).
SPOTIFY_TITLE_FILTER=diet

# --- Server ---
PORT=8787
# Optional: lock the HUD behind a passcode (leave empty to keep it open).
HUD_PASSCODE=
# Where notes/tasks are persisted (JSON file).
HUD_DATA_FILE=data/notes.json
